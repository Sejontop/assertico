generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String           @id
  email       String           @unique
  role        Role             @default(USER)
  createdAt   DateTime         @default(now())
  collections Collection[]
  history     RequestHistory[]
  auditLogs   AuditLog[]

  @@map("users")
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  description String?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests    Request[]

  @@index([userId])
  @@map("collections")
}

model Request {
  id           String           @id @default(cuid())
  name         String
  method       HttpMethod
  url          String
  headers      Json?
  queryParams  Json?
  body         Json?
  bodyType     BodyType         @default(NONE)
  collectionId String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assertions   Assertion[]
  history      RequestHistory[]
  collection   Collection       @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@map("requests")
}

model Assertion {
  id            String            @id @default(cuid())
  requestId     String
  type          AssertionType
  path          String?
  operator      AssertionOperator
  expectedValue String
  createdAt     DateTime          @default(now())
  request       Request           @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("assertions")
}

model RequestHistory {
  id               String     @id @default(cuid())
  userId           String
  requestId        String?
  method           HttpMethod
  url              String
  headers          Json?
  body             Json?
  status           Int
  durationMs       Int
  assertionsPassed Int        @default(0)
  assertionsFailed Int        @default(0)
  createdAt        DateTime   @default(now())
  request          Request?   @relation(fields: [requestId], references: [id])
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([requestId])
  @@index([createdAt])
  @@map("request_history")
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum BodyType {
  NONE
  JSON
  RAW
  FORM_DATA
}

enum AssertionType {
  STATUS
  BODY
  HEADER
}

enum AssertionOperator {
  EQUALS
  NOT_EQUALS
  CONTAINS
  EXISTS
  GREATER_THAN
  LESS_THAN
  REGEX
}

enum Role {
  USER
  ADMIN
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}
