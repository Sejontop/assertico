# Prisma / PostgreSQL
# DATABASE_URL uses Supabase's connection pooler (pgbouncer) for app queries.
# DIRECT_URL bypasses the pooler and is required for migrations.
DATABASE_URL="postgresql://postgres:password@localhost:5432/assertico?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@localhost:5432/assertico"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Used to build the Supabase email-confirmation redirect link.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
